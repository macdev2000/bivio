{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bivio",
  "version": "0.1.4",
  "identifier": "net.bivio.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bivio",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Editor di librogame",
    "longDescription": "Bivio è un editor libero e multipiattaforma per scrivere librogame e racconti a bivi: paragrafi collegati, mappa, rimescolamento, prova di gioco ed esportazione in PDF, Word, ePub e HTML.",
    "copyright": "© 2026 Andrew Jones",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}